# PresensiKu Enterprise - Environment Variables Template
# Copy this file to .env and fill in with your real credentials

DATABASE_URL=postgresql://user:password@hostname:5432/presensiku_db?sslmode=require
PORT=8080
GRPC_PORT=50051
JWT_SECRET=your-secure-jwt-secret-key-here
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
GRPC_SERVER_URL=localhost:50051
